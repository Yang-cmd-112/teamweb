---
layout: default
---
{% assign hero_image = page.profile.image | prepend: '/assets/img/' %}

<div class="ami-home">
  <header class="ami-hero">
    <div class="ami-hero-content">
      <p class="ami-affiliation">华中科技大学</p>
      <h1>应用磁学与集成课题组</h1>
      <p>{{ page.subtitle }}</p>
      <nav class="ami-hero-links" aria-label="首页快捷入口">
        <a href="{{ '/people/' | relative_url }}">科研团队</a>
        <a href="{{ '/publications/' | relative_url }}">科研成果</a>
      </nav>
    </div>
  </header>
  <figure class="ami-home-photo">
  <img class="ami-hero-image" src="{{ hero_image | relative_url }}" alt="">
  </figure>

  {% if page.latest_posts and site.latest_posts.enabled %}
    <section class="ami-section" aria-labelledby="ami-news-title">
      <div class="ami-section-heading">
        <h2 id="ami-news-title">科研动态</h2>
        <a href="{{ '/blog/' | relative_url }}">查看全部动态 →</a>
      </div>
      {% include latest_posts.liquid %}
    </section>
  {% endif %}

  {% if page.selected_papers %}
    <section class="ami-section" aria-labelledby="ami-papers-title">
      <div class="ami-section-heading">
        <h2 id="ami-papers-title">代表性成果</h2>
        <a href="{{ '/publications/' | relative_url }}">查看全部成果 →</a>
      </div>
      {% include selected_papers.liquid %}
    </section>
  {% endif %}

  <section class="ami-section" aria-labelledby="ami-about-title">
    <h2 id="ami-about-title">课题组负责人</h2>
    {{ content }}
  </section>

  {% if page.profile.more_info %}
    <section class="ami-section" aria-labelledby="ami-contact-title">
      <h2 id="ami-contact-title">联系我们</h2>
      {{ page.profile.more_info }}
    </section>
  {% endif %}
</div>
